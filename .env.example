# ==========================================
# CityFlow Environment Configuration Example
# ==========================================
# Copy to .env and adjust variables as needed for local development.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Spatial Database (PostgreSQL + PostGIS)
POSTGRES_USER=cityflow
POSTGRES_PASSWORD=cityflow_dev_secret
POSTGRES_DB=cityflow_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cityflow:cityflow_dev_secret@127.0.0.1:5432/cityflow_db

# Kafka Event Streaming (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRAFFIC_EVENTS=bengaluru.traffic.events.v1
KAFKA_TOPIC_TRANSIT_DELAYS=bengaluru.transit.delays.v1
KAFKA_GROUP_ID=cityflow-streaming-analytics

# Spark Structured Streaming
SPARK_APP_NAME=CityFlowStreamingAnalytics
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=./data/checkpoint

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
